#include <stdio.h>
#include <stdlib.h>

#define n 5

void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Fixed array type to int arr[]
void heapify(int arr[], int N, int i) {
    int largest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    // Fixed: Correct max-heap comparison logic
    if (left < N && arr[left] > arr[largest]) {
        largest = left;
    }

    if (right < N && arr[right] > arr[largest]) {
        largest = right;
    }

    if (largest != i) {
        swap(&arr[i], &arr[largest]); // Fixed: Passed addresses using &
        heapify(arr, N, largest);     // Fixed: Use N instead of macro n
    }
}

void heapsort(int arr[], int N) {
    // Fixed: Start at N/2 - 1 and passed missing 'arr' and 'N' variables
    for (int i = N / 2 - 1; i >= 0; i--) {
        heapify(arr, N, i);
    }

    for (int i = N - 1; i > 0; i--) { // i > 0 is enough since 0 doesn't need to swap with itself
        swap(&arr[0], &arr[i]);       // Fixed: Added missing & to arr[i]
        heapify(arr, i, 0);           // Fixed: Pass 'i' to shrink the active heap size
    }
}

int main() {
    int arr[5];
    for (int i = 0; i < n; i++) {
        arr[i] = rand() % 10000;
    }

    heapsort(arr, n);

    // Added a space in printf for readability
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
